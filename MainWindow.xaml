<Window x:Class="MyDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded"
        Title="Payslip Generator" >
    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="LightGray" Padding="10" BorderBrush="DarkGray" BorderThickness="0,0,0,1">
            <StackPanel >
                <TextBlock FontSize="20" FontWeight="Bold" Text="Payslip Generator" Margin="0,0,20,0"/>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Human Arm" Margin="0,0,20,0"/>
            </StackPanel>
        </Border>


         <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="LightGray" Padding="5" BorderBrush="DarkGray" BorderThickness="1,1,1,1" >
            <TextBlock HorizontalAlignment="Center" FontStyle="Italic" Foreground="Gray" Text="© 2025 Human Arm. All rights reserved."/>
        </Border>


        <!-- Main Frame for Pages -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>
