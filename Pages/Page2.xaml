<Page x:Class="MyDesktopApp.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Page2">

    <Page.Resources>
        <!-- Pastel Blue Theme -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#A7C7E7"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#2E3A59"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LightGray" Color="#F4F8FE"/>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Background" Value="{StaticResource LightGray}"/>
            <Setter Property="BorderBrush" Value="#C6D9EF"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <!-- <Setter Property="CornerRadius" Value="6"/> -->
        </Style>
    </Page.Resources>

    <Grid Background="#F2F6FC" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Please select your employee from the dropdown"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryDark}"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Main Content -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="520" Margin="0,0,0,20">

            <!-- Employee Dropdown -->
                <!-- <ComboBoxItem Content="Select employee" IsEnabled="False"/> -->

        <ComboBox x:Name="EmployeeComboBox"
          Width="300"
          IsEditable="True"
          IsTextSearchEnabled="True"
          StaysOpenOnEdit="True"
          SelectionChanged="EmployeeComboBox_SelectionChanged"
          SelectedIndex="0"> <!-- default placeholder -->
</ComboBox>

            <!-- Details Panel -->
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="10"
                    BorderBrush="#D6E6F2"
                    BorderThickness="1.5"
                    Padding="15"
                    Margin="0,20,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="250">
                    <StackPanel x:Name="DetailsPanel"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20" >
            <Button Content="Back to Page 1"
                    Width="160"
                    Background="{StaticResource PrimaryBlue}"
                    Foreground="{StaticResource PrimaryDark}"
                    Click="GoToPage1_Click"/>

            <Button Content="Generate PDF"
                    Width="160"
                    Background="{StaticResource PrimaryDark}"
                    Foreground="White"
                    Click="GeneratePDF_Click"/>
        </StackPanel>
    </Grid>
</Page>
